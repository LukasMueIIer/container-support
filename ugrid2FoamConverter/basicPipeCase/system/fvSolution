FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0;
        minIter 0;
        maxIter 1000;
    }
    pFinal
    {
      $p ;
      tolerance 1e-8;
      relTol 0;
      maxIter 1000;
      minIter 1;
    }

    "alpha.water.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 1;
        cAlpha          1;

        MULESCorr       yes;
        nLimiterIter    3;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;

        minIter 3;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0;
        minIter 3;
    }

    p_rgh
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-07;
        relTol          0.001;
        minIter 3;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
    }

    "(U|k|epsilon|omega).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-08;
        relTol          0;
        minIter         3;
    }
    
}

PIMPLE
{
    momentumPredictor   no;
    nOuterCorrectors    4;

    nCorrectors         2;

    nNonOrthogonalCorrectors 0;
    turbOnFinalIterOnly false;
}

relaxationFactors
{
    equations
    {
        p               1;
        U               1;
        "(k|omega)"     1;
    }
}


